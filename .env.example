# GEMINI_API_KEY: Required for Gemini Multimodal AI OCR calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase PostgreSQL & Auth Credentials (Optional for local mode, required for Supabase cloud sync):
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."
# Server-only: Never expose to browser
SUPABASE_SECRET_KEY="eyJhbGciOi..."

# Storage & OCR Configuration
SUPABASE_STORAGE_BUCKET="evidence"
OCR_PROVIDER="Google Gemini 2.5 Flash Multimodal OCR"
